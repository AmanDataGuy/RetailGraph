# RetailGraph — environment variables
# Copy to .env and fill in. Never commit .env (it is gitignored).
#
# Only these variables are read by the code. Each entry notes which module uses it.

# ── Neo4j (knowledge graph) ──────────────────────────────────────────────────
# Used by: src/graph/queries.py, src/graph/hybrid_search.py, src/graph/builder.py,
#          src/agent/nodes.py, src/api/routes/*, scripts/create_indexes.py
# Local Docker:  bolt://localhost:7687
# Neo4j AuraDB:  neo4j+s://<instance-id>.databases.neo4j.io
# NOTE: AuraDB Free auto-pauses when idle and is deleted after ~30 days idle.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# ── Qdrant (vector store, 384-dim MiniLM embeddings) ─────────────────────────
# Used by: src/graph/vector_store.py, src/graph/hybrid_search.py, src/api/routes/analytics.py
# Local Docker:  http://localhost:6333  (leave QDRANT_API_KEY empty)
# Qdrant Cloud:  https://<cluster>.cloud.qdrant.io  (API key required)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Groq (agent LLM — llama-3.3-70b-versatile) ───────────────────────────────
# Used by: src/agent/llm.py  (intent extraction + answer formatting)
# Get a key at: https://console.groq.com
GROQ_API_KEY=gsk_...

# ── OpenAI (offline training only — NOT needed to run the app) ───────────────
# Used by: training/llm_judge.py, training/generate_pairs.py, training/generate_synthetic.py
# Only required if you re-run the training-data pipeline or the LLM-as-Judge eval.
OPENAI_API_KEY=sk-...
