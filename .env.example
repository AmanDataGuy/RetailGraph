# RetailGraph — environment variables
# Copy to .env and fill in. Never commit .env (it is gitignored).
#
# Only these variables are read by the code. Each entry notes which module uses it.

# ── Neo4j (knowledge graph) ──────────────────────────────────────────────────
# Used by: src/retailgraph/graph/queries.py, src/retailgraph/graph/hybrid_search.py, src/retailgraph/graph/builder.py,
#          src/retailgraph/agent/nodes.py, src/retailgraph/api/routes/*, scripts/create_indexes.py
# Local Docker:  bolt://localhost:7687
# Neo4j AuraDB:  neo4j+s://<instance-id>.databases.neo4j.io
# NOTE: AuraDB Free auto-pauses when idle and is deleted after ~30 days idle.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# ── Qdrant (vector store, 384-dim MiniLM embeddings) ─────────────────────────
# Used by: src/retailgraph/graph/vector_store.py, src/retailgraph/graph/hybrid_search.py, src/retailgraph/api/routes/analytics.py
# Local Docker:  http://localhost:6333  (leave QDRANT_API_KEY empty)
# Qdrant Cloud:  https://<cluster>.cloud.qdrant.io  (API key required)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Groq (all LLM calls — agent, eval, training) ─────────────────────────────
# Used by: src/retailgraph/agent/llm.py, eval/, training/ (generate_pairs, generate_visual_pairs, llm_judge)
# Get a key at: https://console.groq.com
GROQ_API_KEY=gsk_...
# Optional extra free-tier keys; src/retailgraph/agent/llm.py rotates to the next one on a 429.
# GROQ_API_KEY_2=gsk_...
# GROQ_API_KEY_3=gsk_...

# ── UI ──────────────────────────────────────────────────────────────────────
# Where Streamlit finds the API. Default http://127.0.0.1:8000; compose sets http://api:8000.
# API_URL=http://127.0.0.1:8000

